#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$remote_ref" == "refs/heads/main" ]] || continue
  if [[ "$local_oid" == "$zero" ]]; then
    printf 'main push gate failed: deleting main is not allowed.\n' >&2
    status=1
    continue
  fi

  if [[ "$remote_oid" == "$zero" ]]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      base_oid="$(git merge-base "$local_oid" origin/main)"
      commit_range="$base_oid..$local_oid"
    else
      base_oid="$(git hash-object -t tree /dev/null)"
      commit_range="$local_oid"
    fi
  else
    base_oid="$remote_oid"
    commit_range="$base_oid..$local_oid"
  fi

  "$root/scripts/check-commit-message.py" --range "$commit_range" || status=1
  "$root/scripts/check-bilingual-docs.py" --base "$base_oid" --head "$local_oid" || status=1
  python3 "$root/plugins/hank-dev/scripts/validate-distribution.py" --base "$base_oid" --head "$local_oid" || status=1
  "$root/scripts/run-main-ai-review.sh" "$base_oid" "$local_oid" || status=1
done

exit "$status"
